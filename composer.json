{
    "name": "metabytes-sro/epost-api",
    "description": "PHP client for the Deutsche Post E-POSTBUSINESS API: send PDFs as physical letters, track delivery, estimate prices.",
    "license": "LGPL-3.0-or-later",
    "type": "library",
    "keywords": [
        "epost",
        "e-post",
        "e-postbusiness",
        "deutsche post",
        "hybrid mail",
        "letter",
        "einschreiben",
        "api-client"
    ],
    "authors": [
        {
            "name": "Richard Henkenjohann",
            "email": "richard@henkenjohann.me",
            "homepage": "https://henkenjohann.me",
            "role": "Original Author"
        },
        {
            "name": "Jachim Dohmeier",
            "email": "info@metabytes.eu",
            "homepage": "https://metabytes.eu",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/metabytes-sro/epost-api",
    "support": {
        "issues": "https://github.com/metabytes-sro/epost-api/issues",
        "source": "https://github.com/metabytes-sro/epost-api",
        "security": "https://github.com/metabytes-sro/epost-api/blob/master/SECURITY.md"
    },
    "funding": [
        {
            "type": "custom",
            "url": "https://metabytes.eu"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "MetabytesSRO\\EPost\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MetabytesSRO\\EPost\\Api\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "fix": "php-cs-fixer fix",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=build/clover.xml"
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan static analysis",
        "check": "Run code style check, static analysis and tests",
        "fix": "Fix code style with PHP-CS-Fixer",
        "lint": "Check code style with PHP-CS-Fixer",
        "test": "Run the PHPUnit test suite",
        "test:coverage": "Run the test suite with code coverage (needs pcov or xdebug)"
    }
}
