# Credentials for the E-POSTBUSINESS API, used by the scripts in examples/.
# The secret is returned by Login::setPassword() when the account is set up.
EPOST_VENDOR_ID=
EPOST_EKP=
EPOST_SECRET=
EPOST_PASSWORD=
# Optional partner-managed customer identifier
EPOST_VENDOR_SUB_ID=

# When set, the examples submit every letter in test mode: the API emails the
# processed PDF to this address and prints nothing.
EPOST_TEST_EMAIL=

# Pricing (optional): tariff "basis" (default) or "250plus"
EPOST_TARIFF=basis

# Negotiated prices as JSON, merged into the defaults; leave empty for the price list
# EPOST_PRICES_JSON={"national":{"basis":{"standard":{"sw_simplex":0.75}}}}
